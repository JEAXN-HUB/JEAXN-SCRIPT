-- JEAXN HUB | 1v1 NORMAL + BLACKLINK 6H | FINAL
local BLACKLINK_URL = "https://blacklink.site/keyscript"
local ADMIN_KEY = "JEAXN-ADMIN"
local KEY_FILE = "JEAXN_1v1_6H.json"
local EXPIRE = 6*60*60
local player = game.Players.LocalPlayer
local Http = game:GetService("HttpService")

local function saveKey(k)
    local data = {key=k, time=os.time()}
    if writefile then writefile(KEY_FILE, Http:JSONEncode(data)) else getgenv().JEAXN_SAVE = data end
end
local function loadKey()
    local ok, cont = pcall(function()
        if isfile and isfile(KEY_FILE) then return readfile(KEY_FILE)
        elseif getgenv().JEAXN_SAVE then return Http:JSONEncode(getgenv().JEAXN_SAVE) end
    end)
    if ok and cont then return Http:JSONDecode(cont) end
end
local function expired()
    local d = loadKey()
    if not d then return true end
    if os.time() - d.time >= EXPIRE then
        if delfile and isfile(KEY_FILE) then delfile(KEY_FILE) end
        getgenv().JEAXN_SAVE=nil
        return true
    end
    return false, d
end

