-- // SISTEMA DE KEYS 6H //
local function saveKey(k)
    local data={key=k,time=os.time()}
    if writefile then
        writefile(KEY_FILE,Http:JSONEncode(data))
    else
        getgenv().JEAXN_KEY_DATA=data
    end
end

local function loadKey()
    local ok,content=pcall(function()
        if isfile and isfile(KEY_FILE) then
            return readfile(KEY_FILE)
        elseif getgenv().JEAXN_KEY_DATA then
            return Http:JSONEncode(getgenv().JEAXN_KEY_DATA)
        end
    end)
    if ok and content then
        return Http:JSONDecode(content)
    end
    return nil
end

local function isExpired()
    local d=loadKey()
    if not d then return true end
    if os.time()-d.time>=EXPIRE then
        if delfile and isfile and isfile(KEY_FILE) then delfile(KEY_FILE) end
        getgenv().JEAXN_KEY_DATA=nil
        return true
    end
    return false
end

